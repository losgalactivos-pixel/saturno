# Copia este fichero como `.env` y ajusta lo que necesites.
# Ninguna variable es obligatoria: Saturno usa OpenStreetMap, que no pide claves.

# Dirección y puerto del servidor local.
# 127.0.0.1 = solo este PC. 0.0.0.0 = también el móvil en tu Wi-Fi (sin contraseña: úsalo solo en redes de confianza).
SATURNO_HOST=127.0.0.1
SATURNO_PORT=8787

# Recomendado por la política de uso de Nominatim: un correo de contacto
# para que los administradores de OSM puedan avisarte si hay un problema.
# Se envía en el User-Agent y en el parámetro `email` de Nominatim.
SATURNO_CONTACT_EMAIL=

# Fichero SQLite con tus ciudades, notas y estados (ruta relativa a la carpeta del proyecto).
SATURNO_DB_PATH=data/saturno.db

# Horas que se reutilizan los resultados de una ciudad antes de volver a pedirlos a OSM.
SATURNO_CACHE_HOURS=24

# Minutos mínimos entre dos actualizaciones forzadas de la misma ciudad.
SATURNO_MIN_REFRESH_MINUTES=10

# Servidores de Overpass API, separados por comas. Se usa el primero y solo se
# pasa al siguiente si el anterior está saturado (429/502/503/504).
SATURNO_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Segundos máximos de una consulta a Overpass.
SATURNO_OVERPASS_TIMEOUT=180

# Servidor de Nominatim (geocodificación de ciudades).
SATURNO_NOMINATIM_URL=https://nominatim.openstreetmap.org
